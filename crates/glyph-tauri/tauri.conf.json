{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyph",
  "identifier": "com.glyphmusic.glyph",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../glyph-ui/dist",
    "beforeDevCommand": "npm --prefix ../../glyph-ui run dev",
    "beforeBuildCommand": "npm --prefix ../../glyph-ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Glyph",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#030303",
        "dragDropEnabled": false,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../assets/icons/icon-32.png",
      "../../assets/icons/icon-128.png",
      "../../assets/icons/icon-256.png",
      "../../assets/icons/glyph.icns",
      "../../assets/icons/glyph.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "glyph"
        ]
      }
    }
  }
}
