<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background playback: media notification + foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- In-app updates: the release APK goes to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Glyph"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Glyph"
        android:networkSecurityConfig="@xml/network_security"
        android:hasCode="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustNothing"
            android:enableOnBackInvokedCallback="false">
            <!-- Predictive back (default from targetSdk 36) skips onBackPressed and
                 just backgrounds the app; the WebView shell needs Back first so the
                 UI can close sheets/overlays or navigate back before backgrounding. -->
            <!-- glyph://jam/<code> (jam invite page, QR code), glyph://p/<id> (playlist links) and glyph://plugin/<id> (glyph.my/plugins). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="glyph" android:host="jam" />
                <data android:scheme="glyph" android:host="p" />
                <data android:scheme="glyph" android:host="plugin" />
            </intent-filter>
        </activity>

        <!-- Share sheet: "Share" / "Open with" Glyph opens the "Add to Glyph" sheet
             over the app it came from, in a task of its own that leaves no trace
             in Recents (ShareActivity). -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.Glyph.Sheet"
            android:taskAffinity="app.glyph.share"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustNothing"
            android:enableOnBackInvokedCallback="false">
            <!-- "Share" from Spotify, YouTube, the browser, ...: song and playlist links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Open with" for music files (file manager, downloads): the sheet asks
                 whether to play it, like it or add it to playlists. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- "Share" of one or more music files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Theme-coloured launcher icons, switched dynamically from MainActivity. -->
        <activity-alias
            android:name=".LauncherGlyph"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherEmber"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher_ember"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOcean"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher_ocean"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherForest"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher_forest"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherViolet"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher_violet"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCrimson"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher_crimson"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMono"
            android:targetActivity=".MainActivity"
            android:label="Glyph"
            android:icon="@mipmap/ic_launcher_mono"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Checks for a new Glyph version and new releases of followed artists
             about twice a day, also while Glyph is closed (Notifications.java). -->
        <service
            android:name=".CheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
